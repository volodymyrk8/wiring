# Local dev defaults (copy to .env and edit). See README.
# Manual browser testing on http://127.0.0.1:5070/:
#   main login — dev@wiring.test / wiring-dev (Дев)
#   chat peer — peer@wiring.test / wiring-dev (Пир)
HOST=127.0.0.1
PORT=5070
FLASK_DEBUG=1
# Local dev: Postgres via docker compose (PostgreSQL is the only supported DB).
DATABASE_URL=postgresql://wiring_dev:wiring_dev@127.0.0.1:5433/wiring_dev
# Production: set DATABASE_URL in /etc/wiring.env (see README Deploy).
# APP_SECRET_KEY=
# SITE_URL=http://127.0.0.1:5070

# Optional Jev ranking experiment. Set one account's numeric users.id; blank disables access.
# Keep the API key server-side. Locally use ignored .env; production uses /etc/wiring.env.
JEV_BETA_USER_ID=
JEV_API_KEY=
JEV_MODEL=jev-latest
# Optional Web Push key override. If unset, the server stores a key pair in push_vapid.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:noreply@wiring.date
