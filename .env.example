# Local dev defaults (copy to .env and edit). See README.
# Manual browser testing on http://127.0.0.1:5070/:
#   main login — dev@wiring.test / wiring-dev (Дев)
#   chat peer — peer@wiring.test / wiring-dev (Пир)
HOST=127.0.0.1
PORT=5070
FLASK_DEBUG=1
# Local dev: Postgres via docker compose (PostgreSQL is the only supported DB).
DATABASE_URL=postgresql://wiring_dev:wiring_dev@127.0.0.1:5433/wiring_dev
# Production: set DATABASE_URL in /etc/wiring.env (see README Deploy).
# APP_SECRET_KEY=
# SITE_URL=http://127.0.0.1:5070
# Optional analytics counters. Leave blank locally to avoid production telemetry.
# GOOGLE_ANALYTICS_ID=
# YANDEX_METRIKA_ID=

# Optional Jev recommendations. Access requires redeeming WIRINGFORYOU, then profile opt-in.
# Keep the API key server-side. Locally use ignored .env; production uses /etc/wiring.env.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Voice transcription in chats. Same key as photo moderation. Leave blank to hide working transcription.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Signup WIRING+ gift. Unset or 1 grants 90 days to every new account. Set to 0 to stop.
# Existing grants stay until they expire. Guests are not included.
# WIRING_SIGNUP_PLUS=1
# Optional Web Push key override. If unset, the server stores a key pair in push_vapid.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:noreply@wiring.date

# Optional social login. Buttons appear only when both values for a provider are set.
# Use separate development OAuth apps; never copy production secrets locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Apple: Services ID and signed ES256 client-secret JWT (rotate before expiry).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# SITE_URL must match the browser origin (local: http://127.0.0.1:5070).
# Callback URLs: ${SITE_URL}${BASE_PATH}/api/auth/{google,yandex,apple}/callback.
# Apple requires a registered HTTPS domain (no localhost/IP callback).
# Production also requires a stable APP_SECRET_KEY and SESSION_COOKIE_SECURE=1.
# Optional additional trusted origins, each with a registered callback at enabled providers.
# This keeps OAuth state cookies on the host where the user started.
# OAUTH_ALLOWED_ORIGINS=https://wiring.club,https://wiring.date
