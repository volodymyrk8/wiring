[Unit]
Description=WIRING dating
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/repos/dating
Environment=HOST=127.0.0.1
Environment=PORT=5070
Environment=BASE_PATH=
Environment=SITE_URL=https://wiring.date
# SQLite fallback when DATABASE_URL is unset (legacy). Prefer Postgres in /etc/wiring.env:
# DATABASE_URL=postgresql://wiring_app:…@127.0.0.1:5432/wiring
Environment=DATING_DB=/var/lib/wiring/wiring.sqlite3
Environment=UPLOAD_DIR=/var/lib/wiring/uploads
Environment=SESSION_COOKIE_SECURE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/wiring.env
StateDirectory=wiring
StateDirectoryMode=0750
UMask=0027
ExecStart=/root/bots/bin/gunicorn --bind 127.0.0.1:5070 --workers 2 --threads 4 --timeout 60 --graceful-timeout 20 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
