[Unit]
Description=WIRING neurodivergent dating MVP
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/repos/dating
Environment=HOST=127.0.0.1
Environment=PORT=5070
Environment=BASE_PATH=/dating
Environment=DATING_DB=/var/lib/wiring/wiring.sqlite3
Environment=SESSION_COOKIE_SECURE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/wiring.env
StateDirectory=wiring
StateDirectoryMode=0750
UMask=0027
ExecStart=/root/bots/bin/gunicorn --bind 127.0.0.1:5070 --workers 2 --threads 4 --timeout 60 --graceful-timeout 20 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
