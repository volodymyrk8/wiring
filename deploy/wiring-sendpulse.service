[Unit]
Description=Sync consenting WIRING contacts to SendPulse
After=network-online.target wiring.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/repos/dating
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/wiring.env
ExecStart=/root/bots/bin/python scripts/sync_sendpulse.py
TimeoutStartSec=10min
UMask=0077
